# Optional API Keys for Last.fm, Libre.fm, and Discord Rich Presence.
# Users can configure these in the Secrets panel in the AI Studio UI if desired.
# Playback, search, lyrics, and library features work without any keys.
# LASTFM_API_KEY=YOUR_LASTFM_API_KEY
# LASTFM_SECRET=YOUR_LASTFM_SECRET
# LIBREFM_API_KEY=YOUR_LIBREFM_API_KEY
# LIBREFM_SECRET=YOUR_LIBREFM_SECRET
# DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID

# YouTube Data API v3 key (configure in the Secrets panel in Google AI Studio)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY
